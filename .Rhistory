return(df)
})
list2env(bases, envir = .GlobalEnv)
for (nombre in c("b1", "b2", "b3", "b4")) {
df <- get(nombre)
cat("\n===", nombre, "===\n")
cat("libro:\n"); print(table(df$libro, df$libro_dic, useNA = "always"))
cat("nivel_educ:\n"); print(table(df$nivel_educ, df$educ_dic, useNA = "always"))
}
# MODELO 0 — VACÍO
modelo_0_b1 <- lmer(
voto ~ 1 + (1 | id_colegio),
data = b1,
REML = TRUE
)
# MODELO 1 — EFECTOS FIJOS
modelo_1_b1 <- lmer(
voto ~ libro_dic + educ_dic + clima_aula_escuela + indice_aula_ind + (1 | id_colegio),
data = b1,
REML = FALSE
)
# MODELO 2 — PENDIENTE ALEATORIA libro_dic
modelo_2_b1 <- lmer(
voto ~ libro_dic + educ_dic + clima_aula_escuela + indice_aula_ind +
(1 + libro_dic | id_colegio),
data    = b1,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 2e5))
)
# MODELO 3 — PENDIENTE ALEATORIA educ_dic
modelo_3_b1 <- lmer(
voto ~ libro_dic + educ_dic + clima_aula_escuela + indice_aula_ind +
(1 + educ_dic | id_colegio),
data    = b1,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 2e5))
)
# MODELO 4 — PENDIENTE ALEATORIA libro_dic + INTERACCIÓN clima
modelo_4_b1 <- lmer(
voto ~ libro_dic + educ_dic + clima_aula_escuela + indice_aula_ind + clima_aula_escuela:libro_dic +
(1 + libro_dic | id_colegio),
data    = b1,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 2e5))
)
# MODELO 5 — PENDIENTE ALEATORIA educ_dic + INTERACCIÓN clima
modelo_5_b1 <- lmer(
voto ~ libro_dic + educ_dic + clima_aula_escuela + indice_aula_ind +  clima_aula_escuela:educ_dic +
(1 + educ_dic | id_colegio),
data    = b1,
REML    = FALSE,
control = lmerControl(optimizer = "bobyqa", optCtrl = list(maxfun = 2e5))
)
