generar_tabla1 <- function(config) {
nombres_cohortes <- names(config)
tabla <- data.frame(
Variable = c(
"N estudiantes",
"% Región Metropolitana",
"Expectativa de voto (%) [IC 95%]",
"Libros en el hogar, categoría alta (%) [IC 95%]",
"Nivel educativo padres, universitario (%) [IC 95%]",
"Clima de aula, M (SD)",
"Participación en votaciones escolares (%) [IC 95%]",
"Participación en asambleas (%) [IC 95%]",
"Aprendizaje sobre el voto (%) [IC 95%]"
),
stringsAsFactors = FALSE
)
tabla[nombres_cohortes] <- NA_character_
tabla[1, nombres_cohortes] <- as.character(fila_n_estudiantes(config))
tabla[2, nombres_cohortes] <- fila_prop_tabla1(config, "region_rm")
tabla[3, nombres_cohortes] <- fila_prop_tabla1(config, "voto")
tabla[4, nombres_cohortes] <- fila_prop_tabla1(config, "libro_alto")
tabla[5, nombres_cohortes] <- fila_prop_tabla1(config, "educ_padres_univ")
tabla[6, nombres_cohortes] <- fila_media_tabla1(config, "clima_aula_ind")
tabla[7, nombres_cohortes] <- fila_prop_tabla1(config, "particip_votaciones")
tabla[8, nombres_cohortes] <- fila_prop_tabla1(config, "particip_asambleas")
tabla[9, nombres_cohortes] <- fila_prop_tabla1(config, "aprendizaje_voto")
tabla
}
tabla1 <- generar_tabla1(config)
