mutate(across(c(M1, M2), ~ 5 - .)) #Para reordenar categorias de no probable a probable
proc_ICCS_2009 <- proc_ICCS_2009 %>%
mutate(across(c(M1, M2, M3), ~ 5 - .))
proc_ICCS_2016 <- proc_ICCS_2016 %>%
mutate(across(c(M1, M2, M3), ~ 5 - .))
