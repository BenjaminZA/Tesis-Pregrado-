lista_bases_dummies <- map(lista_bases, function(df) {
df_procesado <- dummy_cols(
df,
select_columns = variables_dummy,
remove_selected_columns = FALSE, # ¡Cambiado a FALSE para conservar las originales!
remove_first_dummy = FALSE       # Mantén en TRUE si vas a usar regresiones y evitar colinealidad
)
return(df_procesado)
})
