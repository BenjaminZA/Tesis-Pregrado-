m1_completo <- lmer(voto ~ libro + nivel_educ + clima_aula_escuela + (1 | id_colegio),
data = b1_preparada)
m1_interaccion <- lmer(voto ~ libro +
nivel_educ * clima_aula_escuela +
(1 | id_colegio),
data = b1_preparada)
tab_model(m0_vacio, m1_completo, m1_interaccion,
dv.labels = c("Modelo Vacío", "Modelo Completo"),
string.pred = "Predictores",
string.est = "Coeficiente (b)",
string.ci = "I.C. (95%)",
string.p = "p-valor")
