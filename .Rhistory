string.ci = "I.C. (95%)",
string.p = "p-valor",
file = "tabla_multinivel.html") # Esto guarda la tabla en tu carpeta de trabajo
pacman::p_load(tidyverse,
dplyr,
haven,
car,
magrittr,
psych,
readxl,
fastDummies,
stargazer)
# Genera una tabla de texto ultra limpia directamente en tu consola
stargazer(m0_vacio, m1_completo,
type = "text",
title = "Modelos Multinivel para Voto",
style = "asq", # Estilo de revista de sociología
model.names = FALSE,
column.labels = c("Modelo Vacío", "Modelo Completo"))
# Extraemos los efectos fijos del modelo completo
tabla_fijos <- as.data.frame(summary(m1_completo)$coefficients)
# Redondeamos a 3 decimales para que sea legible
tabla_fijos <- round(tabla_fijos, 3)
# Ver la tabla ordenada en consola
print(tabla_fijos)
library(modelsummary)
pacman::p_load(tidyverse,
dplyr,
haven,
car,
magrittr,
psych,
readxl,
fastDummies,
stargazer,
modelsummary)
# Creamos una lista con los modelos
lista_modelos <- list(
"M0: Vacío" = m0_vacio,
"M1: Completo" = m1_completo
)
# Mostramos la tabla en consola o formato limpio
modelsummary(lista_modelos,
stars = TRUE,
output = "markdown") # Puedes cambiar "markdown" por "html" o "latex"
