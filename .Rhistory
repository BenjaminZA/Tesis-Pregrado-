proc_ICCS_2016_2  <- centrar_en_escuela2(proc_ICCS_2016,  variables_centrar)
proc_PACES_2019_2 <- centrar_en_escuela2(proc_PACES_2019, variables_centrar)
#Función
centrar_gran_media <- function(datos, variables, factor = 1, id_escuela = "id_colegio") {
for (var in variables) {
if (!var %in% names(datos)) next
x <- as.numeric(datos[[var]])
por_escuela <- tapply(x, datos[[id_escuela]], function(z) z[!is.na(z)][1]) #Este codigo permite prevenir NA en los promedios
gran_media  <- mean(por_escuela, na.rm = TRUE)
datos[[paste0(var, "_gmc")]] <- (x - gran_media) * factor
}
datos
}
