ungroup()
# ICCS 2016
proc_ICCS_2016 <- proc_ICCS_2016 %>%
mutate(indice_aula_ind = rowMeans(select(., N3, N5, N7, N8, N9), na.rm = TRUE)) %>%
group_by(id_colegio) %>%
mutate(clima_aula_escuela = mean(indice_aula_ind, na.rm = TRUE)) %>%
ungroup()
