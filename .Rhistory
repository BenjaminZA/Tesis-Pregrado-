"1=0; 2=1; 3=2; 4=3; 5=4",
as.numeric = TRUE)
proc_ICCS_2009$Nive_educ_padre <- car::recode(proc_ICCS_2009$Nive_educ_padre,
"6=0; 5=1; 3=2; 4=2; 2=3; 1=4",
as.numeric = TRUE)
proc_ICCS_2016$Nive_educ_padre <- car::recode(proc_ICCS_2016$Nive_educ_padre,
"5=0; 4=1; 3=2; 2=3; 1=4",
as.numeric = TRUE)
