etiq     <- c(CIVED_1999 = "CIVED 1999", ICCS_2009 = "ICCS 2009",
ICCS_2016 = "ICCS 2016", PACES_2019 = "PACES 2019")
ITEMS_MANUAL <- list(
# Ejemplo (descomenta y reemplaza por los nombres reales de tus columnas):
# CIVED_1999 = c(nacional = "NOMBRE_COL_1", informarse = "NOMBRE_COL_2"),
# ICCS_2009  = c(nacional = "NOMBRE_COL_1", informarse = "NOMBRE_COL_2", local = "NOMBRE_COL_3"),
# ICCS_2016  = c(nacional = "NOMBRE_COL_1", informarse = "NOMBRE_COL_2", local = "NOMBRE_COL_3"),
# PACES_2019 = c(nacional = "NOMBRE_COL_1", informarse = "NOMBRE_COL_2", local = "NOMBRE_COL_3")
)
# Variables para la comparación rápida de efectos (sección 8)
VAR_ID      <- "id_colegio"
VAR_BINARIA <- "voto"
VAR_CLIMA   <- "indice_aula_ind"       # clima de aula individual (se centra dentro de la escuela)
