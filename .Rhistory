coh_p <- "CIVED_1999"
pd_p  <- fig2$datos %>% filter(cohorte == coh_p, fila == "ind")
rg_p  <- fig2$rugs  %>% filter(cohorte == coh_p, fila == "ind")
ylim_p <- c(max(0, floor(min(pd_p$conf.low) * 20) / 20), min(1, ceiling(max(pd_p$conf.high) * 20) / 20))
fig2_cived_ind <- ggplot(pd_p, aes(x, predicted, colour = grupo, linetype = grupo, fill = grupo)) +
geom_ribbon(aes(ymin = conf.low, ymax = conf.high), alpha = .15, colour = NA) +
geom_line(linewidth = .8) +
geom_rug(data = rg_p, aes(x = x), inherit.aes = FALSE, sides = "b", alpha = .05, linewidth = .2,
length = unit(.03, "npc")) +
scale_colour_manual(values = COL_GRUPOS[c(2, 1)]) + scale_fill_manual(values = COL_GRUPOS[c(2, 1)]) +
scale_linetype_manual(values = c("dashed", "solid")) +
scale_x_continuous(breaks = scales::breaks_pretty(n = 5)) +
scale_y_continuous(limits = ylim_p, labels = scales::label_percent(accuracy = 1)) +
labs(title = "CIVED 1999",
x = "Clima de aula individual\n(centrado en la media de la escuela)",
y = "Probabilidad predicha de\nesperar votar",
colour = "Libros en el hogar", fill = "Libros en el hogar", linetype = "Libros en el hogar") +
tema_tesis() + theme(plot.title = element_text(face = "bold", size = 10, hjust = .5))
ggsave(file.path(dir_out, "figura2_CIVED1999_libros_clima_individual.png"), fig2_cived_ind,
width = 12.5, height = 9.5, units = "cm", dpi = 300, bg = "white")
fig2_cived_ind
