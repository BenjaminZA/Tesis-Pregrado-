m4_int_educ_asamblea <- lmer(voto ~ libro + clima_aula_escuela + P3_centrada + P5_centrada + tasa_voto_escuela +
nivel_educ * tasa_asamblea_escuela +
(1 | id_colegio),
data = b4)
# 5. Interacción 4: Libros en el hogar × Tasa de Asamblea Escolar
m4_int_libro_asamblea <- lmer(voto ~ nivel_educ + clima_aula_escuela + P3_centrada + P5_centrada + tasa_voto_escuela +
libro * tasa_asamblea_escuela +
(1 | id_colegio),
data = b4)
# ==============================================================================
# GENERACIÓN DE LA TABLA COMPARATIVA B4
# ==============================================================================
tab_model(m4_sin_interaccion, m4_int_educ_voto, m4_int_libro_voto, m4_int_educ_asamblea, m4_int_libro_asamblea,
dv.labels = c("Sin Interacción", "Int: Educ x Voto", "Int: Libro x Voto", "Int: Educ x Asamblea", "Int: Libro x Asamblea"),
string.pred = "Predictores",
string.est = "Coeficiente (b)",
string.p = "p-valor",
show.ci = FALSE)
