nombres_modelos <- names(lista_modelos)
if (is.null(nombres_modelos)) {
nombres_modelos <- paste0("modelo_", seq_along(lista_modelos))
}
# 2. Crear un entorno temporal aislado para no ensuciar el Global Environment
env_temporal <- new.env(parent = parent.frame())
# 3. Asignar cada modelo a su nombre correspondiente dentro de este entorno
for (i in seq_along(lista_modelos)) {
assign(nombres_modelos[i], lista_modelos[[i]], envir = env_temporal)
}
# 4. Construir la llamada a tab_model usando los SÍMBOLOS (nombres de variables)
argumentos_modelos <- lapply(nombres_modelos, as.symbol)
argumentos_extras <- list(...)
llamada <- as.call(c(
list(quote(sjPlot::tab_model)),
argumentos_modelos,
argumentos_extras
))
# 5. Evaluar la llamada dentro del entorno temporal donde residen los objetos
eval(llamada, envir = env_temporal)
}
correr_modelos_multinivel <- function(
lista_bases,          # lista NOMBRADA de data frames, ej: list(CIVED_1999 = CIVED_1999, ...)
variable_dependiente,  # ej: "voto"
var_nivel1_a,           # ej: "libros"
var_nivel1_b,           # ej: "nivel_educ"
cluster,                # ej: "id_colegio"
variable_contextual,    # ej: "clima_aula_escuela"
subcarpeta              # ej: "clima_aula_escuela"  -> se guarda en output/subcarpeta/
) {
# --- Ruta de salida ---------------------------------------------------
ruta_salida <- here::here("output", subcarpeta)
# Asegurar de manera preventiva que la carpeta exista en el disco
if (!dir.exists(ruta_salida)) {
dir.create(ruta_salida, recursive = TRUE)
}
# --- Contenedores para las tablas comparativas entre bases ----------------
modelos_pred_solo <- list()
modelos_inter_a   <- list()
modelos_inter_b   <- list()
# --- Helper para armar fórmulas --------------------------------------------
f <- function(rhs) as.formula(paste(variable_dependiente, "~", rhs))
# ============================ LOOP SOBRE LAS 4 BASES =======================
for (nombre_base in names(lista_bases)) {
datos <- lista_bases[[nombre_base]]
message("Ajustando modelos para: ", nombre_base)
# Modelo 1: vacío (para ICC)
m1 <- do.call(lmer, list(
formula = f(paste0("1 + (1|", cluster, ")")),
data = datos, REML = TRUE
))
# Modelo 2: solo predictores (efectos fijos, intercepto aleatorio)
m2 <- do.call(lmer, list(
formula = f(paste0(var_nivel1_a, " + ", var_nivel1_b, " + ", variable_contextual,
" + (1|", cluster, ")")),
data = datos, REML = TRUE
))
# Modelo 3: predictores + pendiente aleatoria de var_nivel1_a
m3 <- do.call(lmer, list(
formula = f(paste0(var_nivel1_a, " + ", var_nivel1_b, " + ", variable_contextual,
" + (1 + ", var_nivel1_a, "|", cluster, ")")),
data = datos, REML = TRUE
))
# Modelo 4: predictores + pendiente aleatoria de var_nivel1_b
m4 <- do.call(lmer, list(
formula = f(paste0(var_nivel1_a, " + ", var_nivel1_b, " + ", variable_contextual,
" + (1 + ", var_nivel1_b, "|", cluster, ")")),
data = datos, REML = TRUE
))
# Modelo 5: interacción contextual x var_nivel1_a + pendiente aleatoria var_nivel1_a
m5 <- do.call(lmer, list(
formula = f(paste0(var_nivel1_a, " * ", variable_contextual, " + ", var_nivel1_b,
" + (1 + ", var_nivel1_a, "|", cluster, ")")),
data = datos, REML = TRUE
))
# Modelo 6: interacción contextual x var_nivel1_b + pendiente aleatoria var_nivel1_b
m6 <- do.call(lmer, list(
formula = f(paste0(var_nivel1_b, " * ", variable_contextual, " + ", var_nivel1_a,
" + (1 + ", var_nivel1_b, "|", cluster, ")")),
data = datos, REML = TRUE
))
# --- Word individual con los 6 modelos de esta base ----------------------
archivo_base <- file.path(
ruta_salida,
paste0("modelos_", nombre_base, "_", variable_contextual, ".docx")
)
sjPlot::tab_model(
m1, m2, m3, m4, m5, m6,
show.icc = TRUE, show.aic = TRUE, show.re.var = TRUE,
dv.labels = c(
"Vacío",
"Predictores",
paste0("+ Aleat. ", var_nivel1_a),
paste0("+ Aleat. ", var_nivel1_b),
paste0("+ Interacción ", var_nivel1_a),
paste0("+ Interacción ", var_nivel1_b)
),
file = archivo_base
)
# --- Guardar modelos relevantes para las tablas comparativas -------------
modelos_pred_solo[[nombre_base]] <- m2
modelos_inter_a[[nombre_base]]   <- m5
modelos_inter_b[[nombre_base]]   <- m6
}
# ===================== WORD COMPARATIVO: PREDICTORES =======================
archivo_pred <- file.path(
ruta_salida, paste0("comparacion_predictores_", variable_contextual, ".docx")
)
tab_model_lista(
modelos_pred_solo,
show.icc = TRUE, show.aic = TRUE,
dv.labels = names(modelos_pred_solo),
file = archivo_pred
)
# ===================== WORD COMPARATIVO: INTERACCIONES =====================
temp_a <- file.path(ruta_salida, paste0("_temp_interaccion_", var_nivel1_a, ".docx"))
temp_b <- file.path(ruta_salida, paste0("_temp_interaccion_", var_nivel1_b, ".docx"))
tryCatch({
tab_model_lista(
modelos_inter_a,
show.icc = TRUE, show.aic = TRUE,
dv.labels = names(modelos_inter_a),
file = temp_a
)
}, error = function(e) {
message("ERROR real al exportar modelos_inter_a: ", conditionMessage(e))
}, warning = function(w) {
message("WARNING real al exportar modelos_inter_a: ", conditionMessage(w))
})
stopifnot("No se generó el archivo temporal de interacción A" = file.exists(temp_a))
tab_model_lista(
modelos_inter_b,
show.icc = TRUE, show.aic = TRUE,
dv.labels = names(modelos_inter_b),
file = temp_b
)
stopifnot("No se generó el archivo temporal de interacción B" = file.exists(temp_b))
archivo_inter <- file.path(
ruta_salida, paste0("comparacion_interacciones_", variable_contextual, ".docx")
)
doc <- read_docx()
doc <- body_add_par(doc, paste("Interacción:", var_nivel1_a, "x", variable_contextual),
style = "heading 1")
doc <- body_add_docx(doc, src = temp_a)
doc <- body_add_break(doc)
doc <- body_add_par(doc, paste("Interacción:", var_nivel1_b, "x", variable_contextual),
style = "heading 1")
doc <- body_add_docx(doc, src = temp_b)
print(doc, target = archivo_inter)
# Limpiar los archivos temporales ya que quedaron fusionados en archivo_inter
file.remove(temp_a, temp_b)
message("Listo. Archivos guardados en: ", ruta_salida)
invisible(list(
modelos_pred_solo = modelos_pred_solo,
modelos_inter_a   = modelos_inter_a,
modelos_inter_b   = modelos_inter_b
))
}
variable_contextual <- "clima_aula_escuela"
# 2) Armar la lista nombrada con las 4 bases (deben estar ya en el environment)
lista_bases <- list(
CIVED_1999 = CIVED_1999,
ICCS_2009  = ICCS_2009,
ICCS_2016  = ICCS_2016,
PACES_2019 = PACES_2019
)
# 3) Correr la función
resultado <- correr_modelos_multinivel(
lista_bases          = lista_bases,
variable_dependiente = "voto",
var_nivel1_a         = "libro",
var_nivel1_b         = "nivel_educ",
cluster              = "id_colegio",
variable_contextual  = variable_contextual,
subcarpeta           = "output/Modelos/Clima_aula"   # o el nombre de carpeta que prefieras
)
library(lme4)
library(sjPlot)
library(officer)
library(here)
# =============================================================================
# FUNCIONES MODULARES
# =============================================================================
#' 1. Ajustar los 6 modelos para una base de datos específica
estimar_modelos_base <- function(datos, dep, n1_a, n1_b, clust, contextual) {
# Helper para fórmulas
f <- function(rhs) as.formula(paste(dep, "~", rhs))
modelos <- list(
Vacio        = lmer(f(paste0("1 + (1|", clust, ")")), data = datos, REML = TRUE),
Predictores  = lmer(f(paste0(n1_a, " + ", n1_b, " + ", contextual, " + (1|", clust, ")")), data = datos, REML = TRUE),
Aleatorio_A  = lmer(f(paste0(n1_a, " + ", n1_b, " + ", contextual, " + (1 + ", n1_a, "|", clust, ")")), data = datos, REML = TRUE),
Aleatorio_B  = lmer(f(paste0(n1_a, " + ", n1_b, " + ", contextual, " + (1 + ", n1_b, "|", clust, ")")), data = datos, REML = TRUE),
Interaccion_A = lmer(f(paste0(n1_a, " * ", contextual, " + ", n1_b, " + (1 + ", n1_a, "|", clust, ")")), data = datos, REML = TRUE),
Interaccion_B = lmer(f(paste0(n1_b, " * ", contextual, " + ", n1_a, " + (1 + ", n1_b, "|", clust, ")")), data = datos, REML = TRUE)
)
return(modelos)
}
#' 2. Exportar la tabla de los 6 modelos de una cohorte/base a Word
exportar_reporte_individual <- function(lista_6_modelos, nombre_base, var_contextual, n1_a, n1_b, ruta_salida) {
archivo <- file.path(ruta_salida, paste0("modelos_", nombre_base, "_", var_contextual, ".docx"))
sjPlot::tab_model(
lista_6_modelos$Vacio,
lista_6_modelos$Predictores,
lista_6_modelos$Aleatorio_A,
lista_6_modelos$Aleatorio_B,
lista_6_modelos$Interaccion_A,
lista_6_modelos$Interaccion_B,
show.icc = TRUE, show.aic = TRUE, show.re.var = TRUE,
dv.labels = c("Vacío", "Predictores", paste0("+ Aleat. ", n1_a), paste0("+ Aleat. ", n1_b), paste0("+ Interac. ", n1_a), paste0("+ Interac. ", n1_b)),
file = archivo
)
}
#' 3. Generar un archivo comparativo entre cohortes para un modelo específico
#' Evitamos pasar listas a sjPlot; asignamos temporalmente al GlobalEnv de forma controlada
exportar_comparativo_final <- function(modelos_por_base, tipo_modelo, titulo, archivo_salida) {
# Extraer el modelo específico (ej: "Predictores") para todas las bases
nombres_bases <- names(modelos_por_base)
# Hack seguro: Inyectamos los modelos con sus nombres reales en el entorno global
# SOLO durante la ejecución de esta tabla para que sjPlot no se confunda con las dimensiones.
for (base in nombres_bases) {
assign(base, modelos_por_base[[base]][[tipo_modelo]], envir = .GlobalEnv)
}
# Construir la llamada explícita con los nombres de las variables globales
argumentos <- lapply(nombres_bases, as.symbol)
llamada <- as.call(c(
list(quote(sjPlot::tab_model)),
argumentos,
list(show.icc = TRUE, show.aic = TRUE, dv.labels = nombres_bases, file = archivo_salida)
))
# Ejecutar
eval(llamada, envir = .GlobalEnv)
# Limpiar el entorno global para dejarlo impecable
rm(list = nombres_bases, envir = .GlobalEnv)
}
