# ---------- VERSIÓN 1: nivel estudiante (clima_aula_ind) ----------
clima_estudiante <- bind_rows(
calc_media_ic_ponderada(CIVED_1999, "indice_aula_ind", "Peso_est", "id_colegio") %>% mutate(base = "CIVED_1999"),
calc_media_ic_ponderada(ICCS_2009,  "indice_aula_ind", "Peso_est", "id_colegio") %>% mutate(base = "ICCS_2009"),
calc_media_ic_ponderada(ICCS_2016,  "indice_aula_ind", "Peso_est", "id_colegio") %>% mutate(base = "ICCS_2016"),
calc_media_ic_ponderada(PACES_2019, "indice_aula_ind", "Peso_est", "id_colegio") %>% mutate(base = "PACES_2019")
)
clima_estudiante$base <- factor(clima_estudiante$base, levels = niveles)
ggplot(clima_estudiante, aes(x = base, y = promedio)) +
geom_col(fill = "steelblue", width = 0.6) +
geom_errorbar(aes(ymin = ic_inf, ymax = ic_sup), width = 0.15, linewidth = 0.6) +
geom_text(aes(y = ic_sup, label = round(promedio, 2)), vjust = -0.7, size = 4) +
labs(title = "Clima de aula — nivel estudiante",
subtitle = "Promedio ponderado (Peso_est) con IC 95%, por base de datos",
x = "Base de datos (año)", y = "Promedio clima_aula_ind") +
theme_minimal(base_size = 13)
# ---- Formateo ----
fmt_prop <- function(df) {
if (is.null(df)) return("N/D")
sprintf("%.1f%% [%.1f%%, %.1f%%]", df$promedio * 100, df$ic_inf * 100, df$ic_sup * 100)
}
fmt_media_sd <- function(df) {
if (is.null(df)) return("N/D")
sprintf("M = %.2f (SD = %.2f)", df$media, df$sd)
}
# ---- Filas ----
fila_prop_tabla1 <- function(config, campo) {
sapply(config, function(coh) {
colname <- coh$vars_ind_prop[[campo]]
if (is.null(colname) || is.na(colname)) return("N/D")
tryCatch(
fmt_prop(calc_prop_ic_ponderado(coh$df, colname, coh$peso_est, coh$id_escuela)),
error = function(e) paste0("ERROR: ", conditionMessage(e))
)
})
}
fila_media_tabla1 <- function(config, campo) {
sapply(config, function(coh) {
colname <- coh$vars_ind_media[[campo]]
if (is.null(colname) || is.na(colname)) return("N/D")
tryCatch(
fmt_media_sd(calc_media_sd_ponderada(coh$df, colname, coh$peso_est)),
error = function(e) paste0("ERROR: ", conditionMessage(e))
)
})
}
fila_media_tabla2 <- function(config, campo) {
sapply(config, function(coh) {
colname <- coh$vars_esc_media[[campo]]
if (is.null(colname) || is.na(colname)) return("N/D")
tryCatch({
colapsada <- colapsar_escuela(coh$df, coh$id_escuela, colname, coh$peso_esc)
fmt_media_sd(calc_media_sd_ponderada(colapsada, colname, coh$peso_esc))
}, error = function(e) paste0("ERROR: ", conditionMessage(e)))
})
}
fila_n_estudiantes <- function(config) sapply(config, function(coh) nrow(coh$df))
fila_n_escuelas <- function(config) sapply(config, function(coh) length(unique(coh$df[[coh$id_escuela]])))
