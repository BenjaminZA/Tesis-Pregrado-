mutate(across(c(M1, M2, M3, libro, N1, N3, N5, N7, N8, N9, Nive_educ_madre,
Nive_educ_padre), ~na_if(., 9)))
colMeans(is.na(proc_PACES_2019)) * 100
proc_CIVED_1999 <- proc_CIVED_1999 %>%
mutate(libro_num = case_when(
libro == 1 ~ 0,  # 0 =0-10 libros
libro == 2 ~ 0,
libro == 3 ~ 2,  # 1 =11-100 libros
libro == 4 ~ 2,  # 2 =101-200 libros
libro == 5 ~ 3,  # 3 =Más de 200 libros
libro == 6 ~ 4))
