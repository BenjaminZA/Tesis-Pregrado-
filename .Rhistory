# Participación en votaciones escolares
proc_PACES_2019 <- proc_PACES_2019 %>%
rename (participacion_voto = P3)
proc_ICCS_2009 <- proc_ICCS_2009 %>%
rename (participacion_voto = P3)
proc_ICCS_2016 <- proc_ICCS_2016 %>%
rename (participacion_voto = P3)
proc_PACES_2019 <- proc_PACES_2019 %>%
rename (asamblea = P5)
proc_ICCS_2009 <- proc_ICCS_2009 %>%
rename (asamblea= P5)
proc_ICCS_2016 <- proc_ICCS_2016 %>%
rename (asamblea = P5)
centrar_en_escuela <- function(datos, variables, id_escuela = "id_colegio") {
for (var in variables) {
if (!var %in% names(datos)) next
media_esc <- ave(datos[[var]], datos[[id_escuela]], FUN = function(x) mean(x, na.rm = TRUE))
datos[[paste0(var, "_cwc")]] <- datos[[var]] - media_esc
}
datos
}
variables_centrar <- c("indice_aula_ind", "aprendizaje_voto", "participacion_voto", "asamblea")
proc_CIVED_1999 <- centrar_en_escuela(proc_CIVED_1999, variables_centrar)
proc_ICCS_2009  <- centrar_en_escuela(proc_ICCS_2009,  variables_centrar)
proc_ICCS_2016  <- centrar_en_escuela(proc_ICCS_2016,  variables_centrar)
proc_PACES_2019 <- centrar_en_escuela(proc_PACES_2019, variables_centrar)
saveRDS(proc_CIVED_1999, "output/data_procesada/proc_CIVED_1999.rds")
saveRDS(proc_ICCS_2009,  "output/data_procesada/proc_ICCS_2009.rds")
saveRDS(proc_ICCS_2016,  "output/data_procesada/proc_ICCS_2016.rds")
saveRDS(proc_PACES_2019,  "output/data_procesada/proc_PACES_2019.rds")
CIVED_1999 <- readRDS("../output/data_procesada/proc_CIVED_1999.rds")
ICCS_2009 <- readRDS("../output/data_procesada/proc_ICCS_2009.rds")
ICCS_2016 <- readRDS("../output/data_procesada/proc_ICCS_2016.rds")
PACES_2019 <- readRDS("../output/data_procesada/proc_PACES_2019.rds")
View(CIVED_1999)
M0 <- lmer(
voto ~ 1 + (1 | id_colegio),
data = CIVED_1999,
REML = TRUE
)
M1 <- lmer(
voto ~ libro + nivel_educ + Sexo + (1 | id_colegio),
data = CIVED_1999,
REML = TRUE
)
M1_a <- lmer(
voto ~ libro + nivel_educ + Sexo + (1 + libro| id_colegio),
data = CIVED_1999,
REML = TRUE
)
M1_b <- lmer(
voto ~ libro + nivel_educ + Sexo + (1 + nivel_educ | id_colegio),
data = CIVED_1999,
REML = TRUE
)
M2 <- lmer(
voto ~ libro + nivel_educ + Sexo + indice_aula_ind_cwc + aprendizaje_voto + (1 | id_colegio),
data = CIVED_1999,
REML = TRUE
)
M3_a <- lmer(
voto ~ libro + nivel_educ + Sexo + indice_aula_ind_cwc + aprendizaje_voto_cwc +
clima_aula_escuela + (1 | id_colegio),
data = CIVED_1999,
REML = TRUE
)
M3_b <- lmer(
voto ~ libro + nivel_educ + Sexo + indice_aula_ind_cwc + aprendizaje_voto_cwc +    perp_aprendizaje_voto_esc + (1 | id_colegio),
data = CIVED_1999,
REML = TRUE
)
M4_a1 <- lmer(
voto ~ libro * clima_aula_escuela +
nivel_educ + Sexo + indice_aula_ind_cwc + aprendizaje_voto_cwc + (1 + libro | id_colegio),
data = CIVED_1999,
REML = TRUE
)
M4_b1 <- lmer(
voto ~ nivel_educ * clima_aula_escuela +
libro + Sexo + indice_aula_ind_cwc + aprendizaje_voto_cwc + (1 + nivel_educ | id_colegio),
data = CIVED_1999,
REML = TRUE
)
M4_a2 <- lmer(
voto ~ libro * perp_aprendizaje_voto_esc +
libro + Sexo + indice_aula_ind_cwc + aprendizaje_voto_cwc + (1 + libro | id_colegio),
data = CIVED_1999,
REML = TRUE
)
M4_b2 <- lmer(
voto ~ nivel_educ * perp_aprendizaje_voto_esc +
libro + Sexo + indice_aula_ind_cwc + aprendizaje_voto_cwc + (1 + nivel_educ| id_colegio),
data = CIVED_1999,
REML = TRUE
)
etiquetas <- c(
"M0: Vacío",
"M1: Nivel 1",
"M1_a: Pend. aleat. (libro)",
"M1_b: Pend. aleat. (nivel_educ)",
"M2: + Controles N1",
"M3_a: + Clima de aula (escuela)",
"M3_b: + Percepción aprendizaje (escuela)",
"M4_a1: Libro × Clima aula",
"M4_b1: Nivel educ × Clima aula",
"M4_a2: Libro × Percepción aprendizaje",
"M4_b2: Nivel educ × Percepción aprendizaje"
)
archivo_docx <- here::here("output", "Modelos_2", "modelos_CIVED_1999_voto.doc")
tabla_1 <-tab_model(
M0, M1, M1_a, M1_b, M2, M3_a, M3_b, M4_a1, M4_b1, M4_a2, M4_b2,
show.re.var = TRUE,
show.icc    = TRUE,
show.r2     = TRUE,
show.ci     = FALSE,
show.p      = FALSE,
p.style     = "stars",
dv.labels   = etiquetas,
file        = archivo_docx
)
tabla_1
view(tabla_1)
