# Comparativo 1: Predictores
exportar_comparativo_final(
modelos_por_base = todos_los_modelos,
tipo_modelo      = "Predictores",
archivo_salida   = file.path("Modelos/Clima_aula", paste0("comparacion_predictores_", variable_contextual, ".docx"))
)
# Comparativo 2: Interacciones (Generamos archivos limpios por separado para evitar colapsos de officer)
exportar_comparativo_final(
modelos_por_base = todos_los_modelos,
tipo_modelo      = "Interaccion_A",
archivo_salida   = file.path("Modelos/Clima_aula", paste0("comparacion_interaccion_", "libros", ".docx"))
)
exportar_comparativo_final(
modelos_por_base = todos_los_modelos,
tipo_modelo      = "Interaccion_B",
archivo_salida   = file.path("Modelos/Clima_aula", paste0("comparacion_interaccion_", "nivel_educ", ".docx"))
)
message("¡Proceso finalizado con éxito!")
