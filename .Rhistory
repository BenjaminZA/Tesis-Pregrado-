proc_ICCS_2016 <- proc_ICCS_2016 %>%
group_by(id_colegio) %>%
mutate(
tasa_voto_escuela     = mean(P3, na.rm = TRUE),
tasa_asamblea_escuela = mean(P5, na.rm = TRUE)
) %>%
ungroup()
# --- BASE 4: PACES 2019 ---
proc_PACES_2019 <- proc_PACES_2019 %>%
group_by(id_colegio) %>%
mutate(
tasa_voto_escuela     = mean(P3, na.rm = TRUE),
tasa_asamblea_escuela = mean(P5, na.rm = TRUE)
) %>%
ungroup()
