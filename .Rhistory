df_procesado <- dummy_cols(
df,
select_columns = variables_dummy,
remove_selected_columns = TRUE, # Elimina las variables originales (opcional)
remove_first_dummy = FALSE      # Cambia a TRUE si necesitas omitir la categoría de referencia
)
return(df_procesado)
})
