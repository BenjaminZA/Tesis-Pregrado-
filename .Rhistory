CIVED_1999 <- readRDS("../output/data_procesada/proc_CIVED_1999.rds")
ICCS_2009 <- readRDS("../output/data_procesada/proc_ICCS_2009.rds")
ICCS_2016 <- readRDS("../output/data_procesada/proc_ICCS_2016.rds")
PACES_2019 <- readRDS("../output/data_procesada/proc_PACES_2019.rds")
calc_prop_ic_ponderado <- function(datos, var, peso, cluster) {
faltantes <- setdiff(c(var, peso, cluster), names(datos))
if (length(faltantes) > 0) {
stop("No encuentro esta(s) columna(s) en la base: ", paste(faltantes, collapse = ", "),
"\nColumnas disponibles: ", paste(names(datos), collapse = ", "))
}
formula_var <- as.formula(paste0("~", var))
diseno <- svydesign(ids = as.formula(paste0("~", cluster)),
weights = as.formula(paste0("~", peso)),
data = datos)
res <- svyciprop(formula_var, diseno, method = "likelihood", na.rm = TRUE)
data.frame(promedio = as.numeric(res), ic_inf = attr(res, "ci")[1],
ic_sup = attr(res, "ci")[2], n = sum(!is.na(datos[[var]])), row.names = NULL)
}
calc_media_sd_ponderada <- function(datos, var, peso) {
faltantes <- setdiff(c(var, peso), names(datos))
if (length(faltantes) > 0) {
stop("No encuentro esta(s) columna(s): ", paste(faltantes, collapse = ", "))
}
x <- datos[[var]]; w <- datos[[peso]]
ok <- !is.na(x) & !is.na(w)
x <- x[ok]; w <- w[ok]
if (length(x) == 0) stop("La variable '", var, "' quedó sin datos válidos tras quitar NA.")
m <- stats::weighted.mean(x, w)
v <- sum(w * (x - m)^2) / sum(w)
data.frame(media = m, sd = sqrt(v), n = length(x), row.names = NULL)
}
colapsar_escuela <- function(datos, id_escuela, vars, peso_esc) {
faltantes <- setdiff(c(id_escuela, vars, peso_esc), names(datos))
if (length(faltantes) > 0) {
stop("No encuentro esta(s) columna(s) al colapsar: ", paste(faltantes, collapse = ", "))
}
datos %>%
distinct(.data[[id_escuela]], .keep_all = TRUE) %>%
select(all_of(c(id_escuela, vars, peso_esc)))
}
