orden_variables_esc <- c("Aprendizaje sobre el voto (tasa escuela)",
"Participación en votaciones (tasa escuela)",
"Participación en asambleas (tasa escuela)",
"Clima de aula (escuela)")
tabla_consolidada_esc <- promedios_todas_esc %>%
mutate(
celda = if_else(
variable == "Clima de aula (escuela)",
sprintf("%.2f (%.2f–%.2f)", promedio, ic_inf, ic_sup),
sprintf("%.1f%% (%.1f%%–%.1f%%)", promedio * 100, ic_inf * 100, ic_sup * 100)
),
variable = factor(variable, levels = orden_variables_esc)
) %>%
select(variable, base, celda) %>%
tidyr::pivot_wider(names_from = base, values_from = celda, values_fill = "N/D") %>%
arrange(variable) %>%
rename(Variable = variable)
tabla_consolidada_esc
doc <- officer::read_docx()
doc <- officer::body_add_table(doc, value = tabla_consolidada_esc)
print(doc, target = "../output/Descriptivos/tabla_consolidada_escuela.docx")
promedios_chart_esc <- promedios_todas_esc %>%
filter(variable != "Clima de aula (escuela)")
ggplot(promedios_chart_esc, aes(x = base, y = promedio, fill = variable)) +
geom_col(position = position_dodge(width = 0.8), width = 0.7) +
geom_text(aes(label = scales::percent(promedio, accuracy = 0.1)),
position = position_dodge(width = 0.8), vjust = -0.4, size = 2.8) +
scale_y_continuous(labels = scales::percent, expand = expansion(mult = c(0, 0.12))) +
labs(
title = "Tasas ponderadas por escuela, por cohorte",
x = "Base de datos (año)", y = "Tasa por escuela", fill = "Variable"
) +
theme_minimal(base_size = 12) +
theme(legend.position = "bottom")
