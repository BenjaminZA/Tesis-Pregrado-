"Sexo"                   = "Sexo (hombre)",
"indice_aula_ind_cwc"    = "Clima de aula, individual (cwc)",
"participacion_voto_cwc" = "Participación en votaciones, individual (cwc)",
"asamblea_cwc"           = "Participación en asambleas, individual (cwc)",
"aprendizaje_voto_cwc"   = "Aprendizaje sobre el voto, individual (cwc)",
"(Intercept)"            = "Intercepto"
)
m2 <- setNames(map(cohortes, ~ MODELOS[[.x]]$M2), etiq[cohortes])
tabla5_or <- modelsummary(
m2,
exponentiate = TRUE,
estimate     = "{estimate}{stars} [{conf.low}, {conf.high}]",
statistic    = NULL,
stars        = c("*" = .05, "**" = .01, "***" = .001),
coef_map     = etiquetas_vars,
gof_map      = c("nobs", "r2.marginal"),
output       = "flextable"
)
