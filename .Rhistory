function(d) sum(is.na(d$id_colegio)))
centrar_en_escuela2 <- function(datos, variables, id_escuela = "id_colegio"){
datos %>%
group_by(across(all_of(id_escuela))) %>%
mutate(across(any_of(variables),
list(est = ~ mean(.x, na.rm = TRUE),
cwc = ~ .x - mean(.x, na.rm = TRUE)),
.names = "{.col}_{.fn}")) %>%
ungroup()
}
variables_centrar <- c("indice_aula_ind", "aprendizaje_voto", "participacion_voto",
"asamblea")
#Centrado
proc_CIVED_1999_2 <- centrar_en_escuela2(proc_CIVED_1999, variables_centrar)
proc_ICCS_2009_2  <- centrar_en_escuela2(proc_ICCS_2009,  variables_centrar)
proc_ICCS_2016_2  <- centrar_en_escuela2(proc_ICCS_2016,  variables_centrar)
proc_PACES_2019_2 <- centrar_en_escuela2(proc_PACES_2019, variables_centrar)
bases_viejas <- list(CIVED_1999 = proc_CIVED_1999, ICCS_2009 = proc_ICCS_2009,
ICCS_2016  = proc_ICCS_2016,  PACES_2019 = proc_PACES_2019)
bases_nuevas <- list(CIVED_1999 = proc_CIVED_1999_2, ICCS_2009 = proc_ICCS_2009_2,
ICCS_2016  = proc_ICCS_2016_2,  PACES_2019 = proc_PACES_2019_2)
for (cohorte in names(bases_viejas)) {
vieja <- bases_viejas[[cohorte]]
nueva <- bases_nuevas[[cohorte]]
vars  <- intersect(paste0(variables_centrar, "_cwc"), names(vieja))
for (v in vars) {
iguales <- isTRUE(all.equal(as.numeric(vieja[[v]]), as.numeric(nueva[[v]])))
cat(cohorte, "-", v, ":", iguales, "\n")
}
}
vars_escuela <- c(vars_clima, vars_prop)
bases <- list(CIVED_1999 = proc_CIVED_1999, ICCS_2009 = proc_ICCS_2009,
ICCS_2016  = proc_ICCS_2016,  PACES_2019 = proc_PACES_2019)
for (cohorte in names(bases)) {
max_distintos <- bases[[cohorte]] %>%
group_by(id_colegio) %>%
summarise(across(any_of(vars_escuela), function(x) n_distinct(x, na.rm = TRUE))) %>%
summarise(across(-id_colegio, max))
cat("\n", cohorte, "\n")
print(max_distintos)
}
pares <- c(clima_aula_escuela        = "indice_aula_ind_est",
tasa_voto_escuela         = "participacion_voto_est",
tasa_asamblea_escuela     = "asamblea_est",
perp_aprendizaje_voto_esc = "aprendizaje_voto_est")
for (cohorte in names(bases)) {
d <- bases[[cohorte]]
for (v_esc in names(pares)) {
v_est <- pares[[v_esc]]
if (!all(c(v_esc, v_est) %in% names(d))) next
dif <- max(abs(as.numeric(d[[v_esc]]) - as.numeric(d[[v_est]])), na.rm = TRUE)
cat(cohorte, "-", v_esc, "vs", v_est, ": diferencia máxima =", round(dif, 6), "\n")
}
}
View(vieja)
