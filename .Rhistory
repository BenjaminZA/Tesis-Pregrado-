3 ~ 1,
4 ~ 1))
proc_ICCS_2016 <- proc_ICCS_2016 %>%
mutate(M1 = case_match(M1,
1 ~ 0,
2 ~ 0,
3 ~ 1,
4 ~ 1)) %>%
mutate(M2 = case_match(M2,
1 ~ 0,
2 ~ 0,
3 ~ 1,
4 ~ 1)) %>%
mutate(M3 = case_match(M3,
