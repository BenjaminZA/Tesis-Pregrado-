centrar_en_escuela2 <- function(datos, variables, id_escuela = "id_colegio"){
datos %>%
group_by(across(all_of(id_escuela))) %>%
mutate(across(any_of(variables),
list(est = ~ mean(.x, na.rm = TRUE),
cwc = ~ .x - mean(.x, na.rm = TRUE)),
.names = "{.col}_{.fn}")) %>%
ungroup()
}
