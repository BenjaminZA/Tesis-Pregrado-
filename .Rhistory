"Educaci\u00F3n de los padres", "figuraA2_interaccion_educacion_clima.png")
figA2$plot
verif <- tibble(verificacion = character(), estado = character(), detalle = character())
anotar <- function(v, ok, det = "") verif <<- bind_rows(verif, tibble(verificacion = v,
estado = ifelse(is.na(ok), "OMITIDA", ifelse(ok, "OK", "REVISAR")), detalle = det))
# --- lectores ---------------------------------------------------------------
# Versiones distintas de sjPlot escriben los nombres como "nivel_educ", "nivel educ" o "libro × clima": se normalizan
norm_termino <- function(x) gsub("[[:space:]_]+", "_", gsub("\\s*[\u00D7:]\\s*", ":", x))
leer_tab_model <- function(archivo) {
h <- xml2::read_html(archivo, encoding = "UTF-8")
filas <- rvest::html_elements(rvest::html_element(h, "table"), "tr")
cel <- lapply(filas, function(f) rvest::html_text2(rvest::html_elements(f, "td, th")))
cel <- cel[lengths(cel) > 0]
mod <- trimws(sub(":.*$", "", cel[[1]][-1]))
fin <- which(map_lgl(cel, ~ .x[1] == "Random Effects"))[1]
coef <- map_dfr(cel[3:(fin - 1)], function(r)
tibble(modelo = mod, termino = r[1], txt = trimws(r[-1]))) %>%
filter(txt != "") %>%
mutate(or_tab = as.numeric(sub("\\s.*$", "", txt)), est_tab = trimws(sub("^[0-9.]+", "", txt)),
termino = norm_termino(termino))
aj <- cel[(fin + 1):length(cel)]
tomar <- function(f, g = identity) { r <- Filter(f, aj); if (length(r) == 0) return(rep(NA_real_, length(mod)))
suppressWarnings(as.numeric(g(trimws(r[[1]][-1])))) }
ajuste <- tibble(modelo = mod,
tau00_tab = tomar(function(r) grepl("00$", r[1]), function(x) sub("\\s.*$", "", x)),
icc_tab   = tomar(function(r) r[1] == "ICC"),
nesc_tab  = tomar(function(r) r[1] == "N", function(x) sub("\\s.*$", "", x)),
nobs_tab  = tomar(function(r) r[1] == "Observations"),
r2m_tab   = tomar(function(r) grepl("^Marginal", r[1]), function(x) sub("\\s*/.*$", "", x)))
list(coef = coef, ajuste = ajuste)
}
leer_docx_tabla <- function(archivo) {
d <- officer::docx_summary(officer::read_docx(archivo)) %>% filter(content_type == "table cell")
w <- d %>% select(row_id, cell_id, text) %>% pivot_wider(names_from = cell_id, values_from = text)
cab <- unlist(w[1, -1]); w <- w[-1, ]; names(w) <- c("row_id", cab); w
}
# --- (1) OR, estrellas y estadísticos de ajuste vs tab_model ----------------
for (coh in cohortes) {
f <- file.path(dir_tab, paste0("modelos_", coh, "_completo_glm.doc"))
if (!file.exists(f)) { anotar(paste("tab_model", coh), NA, paste("no encontrado:", basename(f))); next }
tm <- leer_tab_model(f)
mis <- coefs %>% filter(cohorte == coh) %>% mutate(termino_n = norm_termino(termino))
tm$coef <- rename(tm$coef, termino_n = termino)
cmp <- mis %>% inner_join(tm$coef, by = c("modelo", "termino_n")) %>%
mutate(ok = abs(or - or_tab) <= .0051 & est_p == est_tab)
falta <- mis %>% anti_join(tm$coef, by = c("modelo", "termino_n"))
anotar(paste("OR y estrellas vs tab_model", coh), all(cmp$ok) && nrow(falta) == 0,
sprintf("%d coeficientes comparados; %d distintos; %d sin pareja en tab_model",
nrow(cmp), sum(!cmp$ok), nrow(falta)))
if (any(!cmp$ok)) print(cmp %>% filter(!ok) %>% select(cohorte, modelo, termino, or, est_p, or_tab, est_tab))
aj <- info_modelos %>% filter(cohorte == coh) %>% inner_join(tm$ajuste, by = "modelo") %>%
left_join(icc_nulo, by = "cohorte")
m0 <- aj %>% filter(modelo == "M0"); m2 <- aj %>% filter(modelo == "M2")
ok_aj <- abs(m2$tau00 - m2$tau00_tab) <= .0051 &&
m2$nobs == m2$nobs_tab && m2$n_esc == m2$nesc_tab &&
(is.na(m2$r2m_tab) || abs(r2_marg$r2m[r2_marg$cohorte == coh] - m2$r2m_tab) <= .0006)
anotar(paste("Pie de Tabla 5 vs tab_model", coh), ok_aj,
sprintf("tau00 M2 %.2f/%.2f; N M2 %d/%d; escuelas %d/%d", m2$tau00, m2$tau00_tab,
m2$nobs, m2$nobs_tab, m2$n_esc, m2$nesc_tab))
# ICC de la Tabla 6: la celda publicada (texto) frente al ICC que informa tab_model para M0
icc_celda <- tabla6[[etiq[coh]]][tabla6$Variable == "ICC (M0)"]
anotar(paste("ICC (M0) en Tabla 6 vs tab_model", coh), isTRUE(abs(as.numeric(icc_celda) - m0$icc_tab) <= .0051),
sprintf("celda %s; tab_model %s", icc_celda, fmt_sc(m0$icc_tab)))
}
# --- (2) AME: el signo de cada AME coincide con el del OR correspondiente ------
# (Tabla 5: todas las variables de M2 salvo el intercepto; Tabla 6: la variable de escuela de cada M3)
coef_t56 <- coefs %>% filter(termino != "(Intercept)", modelo == "M2" | grepl("^M3_", modelo)) %>%
filter(modelo == "M2" | termino %in% vars_esc_todas)
chk_ame <- coef_t56 %>% left_join(ame, by = c("cohorte", "modelo", "termino")) %>%
mutate(ok_signo = sign(ame) == sign(log(or)), ok_ic = ame_lo <= ame & ame <= ame_hi)
anotar("Cada coeficiente de las Tablas 5 y 6 tiene AME", !anyNA(chk_ame$ame),
sprintf("%d coeficientes; %d sin AME", nrow(chk_ame), sum(is.na(chk_ame$ame))))
anotar("Signo del AME = signo del OR (Tablas 5 y 6)", isTRUE(all(chk_ame$ok_signo)),
sprintf("%d comparados; %d con signo distinto", nrow(chk_ame), sum(!chk_ame$ok_signo, na.rm = TRUE)))
anotar("El AME queda dentro de su IC 95%", isTRUE(all(chk_ame$ok_ic)))
if (any(!chk_ame$ok_signo, na.rm = TRUE))
print(chk_ame %>% filter(!ok_signo) %>% select(cohorte, modelo, termino, or, ame, ame_lo, ame_hi))
# --- (3) Cobertura: modelos, interacciones y celdas ---------------------------
esperados <- c(CIVED_1999 = 8, ICCS_2009 = 12, ICCS_2016 = 16, PACES_2019 = 12)
anotar("48 pruebas de interacci\u00F3n (8 + 12 + 16 + 12)",
all(as.integer(table(inter$cohorte)[cohortes]) == as.integer(esperados[cohortes])) && nrow(inter) == 48,
paste(n_tests$txt, collapse = "; "))
anotar("Sin NA en estimaciones de interacci\u00F3n", !anyNA(inter[, c("or", "lo", "hi", "p")]))
sin_vacios <- function(df, secciones) {
x <- df[setdiff(seq_len(nrow(df)), secciones), -1]
!any(is.na(x) | x == "")
}
anotar("Sin celdas vac\u00EDas en Tabla 5", sin_vacios(tabla5, nrow(t5_vars) + 1))
anotar("Sin celdas vac\u00EDas en Tabla 6", sin_vacios(tabla6, sec6))
anotar("Sin celdas vac\u00EDas en Tabla 7", sin_vacios(tabla7, sec7))
anotar("Misma muestra en M3 que en M2 (mismo N de estudiantes)",
all(info_modelos %>% filter(grepl("^M3_", modelo)) %>% left_join(
info_modelos %>% filter(modelo == "M2") %>% select(cohorte, nobs_m2 = nobs), by = "cohorte") %>%
mutate(ok = nobs == nobs_m2) %>% pull(ok)),
"si falla, hay datos perdidos en alguna variable de escuela")
anotar("Sin avisos de convergencia", all(info_modelos$aviso == "ninguno"))
# --- (4) Archivos de salida ----------------------------------------------------
salidas <- c("tabla5_M2_por_cohorte.docx", "tabla6_M3_escuela.docx", "tabla7_interacciones_M4.docx",
"figura2_interaccion_libros_clima.png", "figuraA2_interaccion_educacion_clima.png")
anotar("Archivos de salida existen", all(file.exists(file.path(dir_out, salidas))),
paste(salidas[!file.exists(file.path(dir_out, salidas))], collapse = ", "))
print(verif, n = Inf, width = Inf)
if (any(verif$estado == "REVISAR")) warning("Hay verificaciones en REVISAR: no uses las tablas hasta resolverlas.")
info_modelos %>% filter(singular) %>% select(cohorte, modelo, tau00, aviso) %>% print(n = Inf)
tibble(archivo = list.files(dir_out, recursive = TRUE)) %>% print(n = Inf)
sessionInfo()$R.version$version.string
